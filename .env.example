# Copiar a .env (nunca commitear .env). En GitHub Actions van como Secrets.

# --- Claude (cerebro) ---
# Opción $0: token de la suscripción Pro/Max → `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# Opción paga alternativa (llm.provider: anthropic_api)
ANTHROPIC_API_KEY=

# --- Cloudflare Workers AI (generación de imagen gratis) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Cloudflare R2 (hosting de medios) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=   # ej. https://pub-xxxx.r2.dev

# --- Instagram API con Instagram Login ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Renovación automática del token (solo GitHub Actions) ---
# Token fine-grained con permiso "Secrets: Read and write" sobre este repo
GH_PAT=

# --- Avisos (opcionales; config.yaml → notifications.channels) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=          # en Gmail: contraseña de aplicación
NOTIFY_EMAIL_TO=
TELEGRAM_BOT_TOKEN=     # @BotFather
TELEGRAM_CHAT_ID=
