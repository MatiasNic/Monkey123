# Copiar a .env (nunca commitear .env). En GitHub Actions van como Secrets.

# --- Claude (cerebro) ---
# Opción $0: token de la suscripción Pro/Max → `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# Opción paga alternativa (llm.provider: anthropic_api)
ANTHROPIC_API_KEY=

# --- Cloudflare Workers AI (generación de imagen gratis) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Cloudflare R2 (hosting de medios) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=   # ej. https://pub-xxxx.r2.dev

# --- Instagram API con Instagram Login ---
IG_USER_ID=
IG_ACCESS_TOKEN=
